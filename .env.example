# Copy to .env to override the defaults in docker-compose.yml. Never commit .env.
POSTGRES_PASSWORD=change-me
# Host folder with your DICOM series (one sub-folder per series)
DICOM_LIBRARY_DIR=./data
# Port of the web app on the host, and the interface it listens on (0.0.0.0 = whole network)
WEB_PORT=8080
WEB_BIND=127.0.0.1
# Parallel job workers, and what each one does
WORKER_REPLICAS=2
WORKER_KINDS=ingest,analyze
JOB_MAX_ATTEMPTS=3
JOB_LEASE_SECONDS=120
LOG_LEVEL=INFO
