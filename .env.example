# Copy to .env to change the defaults in docker-compose.yml. Never commit .env.
# The database password is applied only when the database volume is first created.
POSTGRES_PASSWORD=change-me
# Host folder holding the DICOM series, one sub-folder per series
DATA_DIR=./data
# Port of the web app on this machine
WEB_PORT=8080
# Browser-reachable object-storage endpoint (must match STORAGE_PORT and the deployment hostname)
STORAGE_PORT=9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=ctviewer
S3_SECRET_KEY=change-this-storage-password
